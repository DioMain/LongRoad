#main-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    -unity-font-definition: resource("Fonts/Raw/Tiny5-Regular");
}

#hud {
    width: 100%;
    flex-direction: row;
    padding: 16px;
    justify-content: space-between;
    height: auto;
}

#inventory {
    flex-grow: 1;
    width: 100%;
}

#dialog {
}

#dialog-next-button {
}

.dialog-body {
    padding: 32px 48px 32px 48px;
}

.dialog-body-text {
    -unity-font-definition: resource("Fonts/Raw/Tiny5-Regular");
    color: rgb(240, 240, 240);
    font-size: 32px;
}

.dialog-button-slot {
    flex-grow: 0;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.dialog-button-slot #DialogChoiceItem {
    min-width: 50%;
}

#main-info {
    flex-grow: 1;
    background-image: resource("Sprites/Hud_Ui#Hud_Ui_0");
    flex-direction: row;
    gap: 8px;
}

#main-info > VisualElement {
    padding: 32px 12px 32px 12px;
}

#money {
    background-image: resource("Sprites/Hud_Ui#Hud_Ui_1");
    flex-grow: 0;
    width: 330px;
    flex-direction: row;
    padding-left: 24px;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
}

#inventory-button {
    width: 402px;
    color: rgb(239, 194, 153);
    font-size: 64px;
}

#day-content {
    flex-direction: row;
    flex-grow: 0;
    width: 350px;
}

#distance-status {
    flex-grow: 0;
    width: 437px;
    background-image: resource("Sprites/Hud_Ui#Hud_Ui_17");
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
}

#reach-distance-text {
    padding-top: 0;
    margin-top: 0;
    font-size: 54px;
    -unity-text-align: upper-center;
}

#party-content {
    flex-grow: 0;
    min-width: 128px;
    background-image: resource("Sprites/Hud_Ui#Hud_Ui_17");
    padding-top: 32px;
    padding-right: 32px;
    padding-bottom: 32px;
    padding-left: 32px;
}
