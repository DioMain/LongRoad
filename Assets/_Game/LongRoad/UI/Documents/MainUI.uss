#main-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
}

#hud {
    flex-shrink: 0;
    width: 100%;
    height: 64px;
    flex-direction: row;
}

#body {
    flex-grow: 1;
    width: 100%;
    flex-direction: row;
}

#party {
    flex-shrink: 0;
    width: 220px;
    height: 100%;
}

#content {
    flex-grow: 1;
    height: 100%;
}

#side {
    flex-shrink: 0;
    width: 240px;
    height: 100%;
    flex-direction: column;
}

#inventory {
    flex-grow: 1;
    width: 100%;
}

#location {
    flex-shrink: 0;
    width: 100%;
    height: 180px;
}

#overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
